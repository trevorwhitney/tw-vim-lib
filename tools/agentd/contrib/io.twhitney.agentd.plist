<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.twhitney.agentd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/twhitney/.local/bin/agentd</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/twhitney/.local/state/agentd/agentd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/twhitney/.local/state/agentd/agentd.log</string>
</dict>
</plist>
